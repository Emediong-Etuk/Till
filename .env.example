# Copy to .env and fill in. Never commit .env.

# --- Deployment (scripts/deploy.ts, make deploy-sepolia) -------------------
# A Sepolia key holding ~0.05 test ETH. Testnet only. Local runs ignore it
# and use anvil's key 0 (override with LOCAL_DEPLOYER_PRIVATE_KEY).
DEPLOYER_PRIVATE_KEY=
# Optional: a separate buyer key for scripts/examples.ts (defaults to the deployer).
BUYER_PRIVATE_KEY=
# Optional: Mallory's key for scripts/demo-exploit.ts on Sepolia.
MALLORY_PRIVATE_KEY=
# Sepolia RPC (Alchemy/Infura/public). Defaults to publicnode.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Base URL of the deployed app; pass tokenURIs point at $APP_URL/api/pass/...
APP_URL=http://localhost:3000

# --- App (app/.env.local) ---------------------------------------------------
# sepolia | local
NEXT_PUBLIC_CHAIN=local
# Comma-separated RPC URLs, tried in order.
NEXT_PUBLIC_RPC_URLS=
# Faucet key (server-side only). On local it defaults to anvil key 9.
FAUCET_PRIVATE_KEY=
# Optional: Upstash Redis for faucet rate limits (otherwise in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Faucet tuning
FAUCET_DRIP_ETH=0.02
FAUCET_MAX_BALANCE_ETH=0.01
FAUCET_DAILY_CAP_ETH=1
