// Layer 3: seeded property tests for the library.
//
// Each case draws a random batch of metered entries (deposits, buys, notes)
// from `KeccakRng::seeded(seed)`, computes what it must cost, then sends it
// either exactly or with one mutation. Properties checked after every case:
//
// - I1 conservation: the probe's credited total equals its ETH balance, and
//   an exact batch credits exactly what was paid.
// - mutated batches revert with the expected error and change nothing.
// - I3 clean frames: the till is (0, false, 0) after every case.
//
// A failing case reverts with `PropFail { seed, case, mutation }`, which is
// enough to replay it.
use core::ptr::MemVec
use std::abi::{Bytes, DynArray}
use std::evm::{Call, Evm, has_selector, wei}
use std::evm::multicall::MulticallMsg
use std::evm::random::{KeccakRng, Rng}
use ingot::{ExternalCallInBatch, NestedBatch, Overspend, TillState, Unspent}
use ingot::probe::{ProbeMsg, TillProbe}
use ingot::entry

#[error]
pub struct PropFail { pub seed: u256, pub case: u256, pub mutation: u256 }

const EXACT: u256 = 0
const PLUS_ONE: u256 = 1
const MINUS_ONE: u256 = 2
const DUPLICATE: u256 = 3
const NESTED: u256 = 4
const FORBIDDEN: u256 = 5
const MUTATIONS: u256 = 6

struct Case { seed: u256, index: u256, mutation: u256 }

impl Copy for Case {}

fn check(_ ok: bool, _ c: Case) {
    if !ok {
        revert_error(
            PropFail { seed: c.seed, case: c.index, mutation: c.mutation },
        )
    }
}

/// One random metered entry and the wei it draws.
fn random_entry() -> (Bytes, Wei) uses (rng: mut Rng) {
    let kind = rng.uniform(3)
    if kind == 0 {
        let amount = wei(rng.uniform(1000))
        (entry(ProbeMsg::Deposit { amount }), amount)
    } else if kind == 1 {
        let price = wei(rng.uniform(300) + 1)
        let qty = rng.uniform(6)
        (entry(ProbeMsg::Buy { price, qty }), price * qty)
    } else {
        (entry(ProbeMsg::Note { text: rng.next() }), Wei::zero())
    }
}

fn run_case(_ probe: Address, _ c: Case) uses (evm: mut Evm, rng: mut Rng) {
    let n = rng.uniform(8) + 1
    var data = MemVec<Bytes>::with_capacity((n + 1).downcast_unchecked())
    var cost = Wei::zero()
    var first_paid = Wei::zero()
    var first_paid_entry = Bytes::empty()
    var i: u256 = 0
    while i < n {
        let (e, w) = random_entry()
        if first_paid == Wei::zero() && w > Wei::zero() {
            first_paid = w
            first_paid_entry = e.clone()
        }
        data.push(e)
        cost = cost + w
        i += 1
    }

    var mutation = c.mutation
    // Mutations that need wei to move fall back to exact when nothing costs.
    if (mutation == MINUS_ONE || mutation == DUPLICATE) && first_paid == Wei::zero() {
        mutation = EXACT
    }
    let case = Case { seed: c.seed, index: c.index, mutation }

    var value = cost
    if mutation == PLUS_ONE {
        value = cost + wei(1)
    } else if mutation == MINUS_ONE {
        value = cost - wei(1)
    } else if mutation == DUPLICATE {
        data.push(first_paid_entry)
    } else if mutation == NESTED {
        data.push(entry(MulticallMsg::Multicall { data: DynArray::empty() }))
    } else if mutation == FORBIDDEN {
        data.push(entry(ProbeMsg::Withdraw {}))
        value = Wei::zero()
    }

    let total_before: Wei = evm
        .call(
            addr: probe,
            gas: 100000,
            value: Wei::zero(),
            message: ProbeMsg::Total {},
        )
    let balance_before = evm.balance(probe)
    let out = with (Call = evm) {
        evm.try_call(
            addr: probe,
            gas: 30000000,
            value,
            message: MulticallMsg::Multicall { data: DynArray::from_mem_vec(data) },
        )
    }
    let total_after: Wei = evm
        .call(
            addr: probe,
            gas: 100000,
            value: Wei::zero(),
            message: ProbeMsg::Total {},
        )
    let balance_after = evm.balance(probe)

    if mutation == EXACT {
        check(out.success(), case)
        check(total_after == total_before + cost, case)
        check(balance_after == balance_before + cost, case)
    } else {
        check(!out.success(), case)
        let data = out.returndata()
        if mutation == PLUS_ONE {
            check(has_selector<Unspent>(data), case)
        } else if mutation == MINUS_ONE || mutation == DUPLICATE {
            check(has_selector<Overspend>(data), case)
        } else if mutation == NESTED {
            check(has_selector<NestedBatch>(data), case)
        } else if mutation == FORBIDDEN {
            // Zero-value batch: a costing entry overspends first, otherwise
            // the forbidden handler is reached.
            check(
                has_selector<ExternalCallInBatch>(data) || has_selector<Overspend>(data),
                case,
            )
        }
        check(total_after == total_before, case)
        check(balance_after == balance_before, case)
    }
    // I1: everything the probe holds was credited exactly once.
    check(total_after == balance_after, case)
    // I3: the till is clean after the frame.
    let s: TillState = evm
        .call(
            addr: probe,
            gas: 100000,
            value: Wei::zero(),
            message: ProbeMsg::State {},
        )
    check(
        s.left == Wei::zero() && !s.batching && s.entries == 0,
        case,
    )
}

fn run_seed(seed: u256, cases: u256) uses (evm: mut Evm) {
    let probe = evm.create2<TillProbe>(value: Wei::zero(), args: (), salt: seed)
    var rng = KeccakRng::seeded(seed)
    var i: u256 = 0
    while i < cases {
        let mutation = i % MUTATIONS
        with (Rng = mut rng) {
            run_case(probe, Case { seed, index: i, mutation })
        }
        i += 1
    }
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn prop_till_seed_1() uses (evm: mut Evm) {
    run_seed(seed: 1, cases: 60)
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn prop_till_seed_2() uses (evm: mut Evm) {
    run_seed(seed: 2, cases: 60)
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn prop_till_seed_3() uses (evm: mut Evm) {
    run_seed(seed: 3, cases: 60)
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn prop_till_seed_4() uses (evm: mut Evm) {
    run_seed(seed: 4, cases: 60)
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn prop_till_seed_5() uses (evm: mut Evm) {
    run_seed(seed: 5, cases: 60)
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn prop_till_seed_0xfe() uses (evm: mut Evm) {
    run_seed(seed: 0xfe, cases: 60)
}
