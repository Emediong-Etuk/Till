// One-tap checkout: whole carts in one metered multicall (I1, I2, I3, I4, I5).
use core::ptr::MemVec
use std::abi::{Bytes, Bytes32, DynArray, dyn_array_from}
use std::evm::{Evm, ether, wei}
use std::evm::multicall::MulticallMsg
use actors::{Relay, RelayMsg}
use ingot::{Erc721Msg, RefundMsg, SaleMsg, SellerMsg}
use ingot::errors::{NotOwner, SoldOut}
use ingot::testkit::{
    GAS,
    actor,
    assert_books_exact,
    assert_reverted_with,
    assert_till_clean,
    balance_of,
    books,
    buy,
    deploy_shop,
    exec,
    item_of,
    owner_of,
    ticket,
    try_exec,
    try_seller,
}
use till::{ExternalCallInBatch, NestedBatch, Overspend, Unspent, entry}

fn checkout(_ who: Address, _ shop: Address, value: Wei, data: own DynArray<Bytes>) -> DynArray<
    Bytes,
>
uses (evm: mut Evm)
{
    let raw = exec(
        who,
        target: shop,
        value,
        data: entry(MulticallMsg::Multicall { data }),
    )
    // The actor returns the multicall's ABI-encoded `bytes[]`; its length
    // word sits after the offset word.
    let _ = raw
    DynArray::empty()
}

fn try_checkout(
    _ who: Address,
    _ shop: Address,
    value: Wei,
    data: own DynArray<Bytes>,
) -> std::evm::CallOutcome
uses (evm: mut Evm)
{
    try_exec(
        who,
        target: shop,
        value,
        data: entry(MulticallMsg::Multicall { data }),
    )
}

fn buys(item: u256, n: u256) -> DynArray<Bytes> {
    var v = MemVec<Bytes>::with_capacity(n.downcast_unchecked())
    var i: u256 = 0
    while i < n {
        v.push(entry(SaleMsg::Buy { item, qty: 1 }))
        i += 1
    }
    DynArray::from_mem_vec(v)
}

/// Tobi's cart: 2 general tickets, 1 shirt and a tip.
fn tobi_cart(general: u256, shirt: u256) -> DynArray<Bytes> {
    dyn_array_from(
        [
            entry(SaleMsg::Buy { item: general, qty: 2 }),
            entry(SaleMsg::Buy { item: shirt, qty: 1 }),
            entry(SaleMsg::Tip { amount: wei(500) }),
        ],
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn one_tap_checkout_exact() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let general = ticket(shop, price: wei(1000), supply: 100)
    let shirt = ticket(shop, price: wei(1500), supply: 40)
    let _ = checkout(
        tobi,
        shop,
        value: wei(2 * 1000 + 1500 + 500),
        data: tobi_cart(general, shirt),
    )
    assert!(balance_of(shop, tobi) == 3)
    assert!(item_of(shop, general).escrow == wei(2000))
    assert!(item_of(shop, shirt).escrow == wei(1500))
    let b = books(shop)
    assert!(
        b.total_escrow == wei(3500) && b.seller_available == wei(500) && b.tips_total == wei(500),
    )
    assert_books_exact(shop)
    assert_till_clean(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_one_wei_over_reverts_unspent() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let general = ticket(shop, price: wei(1000), supply: 100)
    let shirt = ticket(shop, price: wei(1500), supply: 40)
    assert_reverted_with(
        try_checkout(
            tobi,
            shop,
            value: wei(4001),
            data: tobi_cart(general, shirt),
        ),
        Unspent { left: wei(1) },
    )
    assert!(balance_of(shop, tobi) == 0)
    assert!(evm.balance(shop) == Wei::zero())
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_one_wei_under_reverts_overspend() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let general = ticket(shop, price: wei(1000), supply: 100)
    let shirt = ticket(shop, price: wei(1500), supply: 40)
    // The tip is the last entry, so it is the one that runs short.
    assert_reverted_with(
        try_checkout(
            tobi,
            shop,
            value: wei(3999),
            data: tobi_cart(general, shirt),
        ),
        Overspend { wanted: wei(500), left: wei(499) },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_one_entry() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: wei(10), supply: 100)
    let _ = checkout(tobi, shop, value: wei(10), data: buys(item, n: 1))
    assert!(balance_of(shop, tobi) == 1)
    assert_books_exact(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_two_entries() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: wei(10), supply: 100)
    let _ = checkout(tobi, shop, value: wei(20), data: buys(item, n: 2))
    assert!(balance_of(shop, tobi) == 2)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_five_entries() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: wei(10), supply: 100)
    let _ = checkout(tobi, shop, value: wei(50), data: buys(item, n: 5))
    assert!(balance_of(shop, tobi) == 5)
    assert!(item_of(shop, item).escrow == wei(50))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_twenty_entries() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: wei(10), supply: 100)
    let _ = checkout(tobi, shop, value: wei(200), data: buys(item, n: 20))
    assert!(balance_of(shop, tobi) == 20)
    assert_books_exact(shop)
    assert_till_clean(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_mixed_gift_tip_note() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let kemi = actor(5)
    let general = ticket(shop, price: wei(1000), supply: 100)
    let vip = ticket(shop, price: wei(3000), supply: 10)
    let data = dyn_array_from(
        [
            entry(SaleMsg::Buy { item: general, qty: 1 }),
            entry(SaleMsg::BuyFor { item: vip, qty: 1, to: kemi }),
            entry(
                SaleMsg::Note { text: Bytes32 { val: 0x48617070792062646179 << 176 } },
            ),
            entry(SaleMsg::Tip { amount: wei(250) }),
        ],
    )
    let _ = checkout(tobi, shop, value: wei(4250), data)
    assert!(balance_of(shop, tobi) == 1 && balance_of(shop, kemi) == 1)
    assert!(owner_of(shop, 2) == kemi)
    assert!(books(shop).seller_available == wei(250))
    assert_books_exact(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_duplicate_entry_reverts_overspend() uses (evm: mut Evm) {
    // Pay for one ticket, list the same Buy twice.
    let shop = deploy_shop(0)
    let mallory = actor(3)
    let item = ticket(shop, price: ether(1), supply: 100)
    assert_reverted_with(
        try_checkout(mallory, shop, value: ether(1), data: buys(item, n: 2)),
        Overspend { wanted: ether(1), left: Wei::zero() },
    )
    assert!(balance_of(shop, mallory) == 0)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn checkout_sold_out_mid_batch_reverts_whole_batch() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: wei(1), supply: 3)
    assert_reverted_with(
        try_checkout(tobi, shop, value: wei(4), data: buys(item, n: 4)),
        SoldOut { item, remaining: 0 },
    )
    assert!(item_of(shop, item).sold == 0)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn nested_multicall_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let mallory = actor(3)
    let item = ticket(shop, price: ether(1), supply: 100)
    let data = dyn_array_from(
        [
            entry(SaleMsg::Buy { item, qty: 1 }),
            entry(MulticallMsg::Multicall { data: buys(item, n: 1) }),
        ],
    )
    assert_reverted_with(
        try_checkout(mallory, shop, value: ether(1), data),
        NestedBatch {},
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn non_payable_seller_op_in_paid_batch_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let item = ticket(shop, price: wei(1), supply: 100)
    let data = dyn_array_from(
        [entry(SaleMsg::Buy { item, qty: 1 }), entry(SellerMsg::Pause { item })],
    )
    let out = with (std::evm::Call = evm) {
        evm.try_call(
            addr: shop,
            gas: GAS,
            value: wei(1),
            message: MulticallMsg::Multicall { data },
        )
    }
    assert!(!out.success())
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn withdraw_in_zero_value_batch_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let sink = actor(9)
    let data = dyn_array_from([entry(SellerMsg::Withdraw { to: sink })])
    let out = with (std::evm::Call = evm) {
        evm.try_call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: MulticallMsg::Multicall { data },
        )
    }
    assert_reverted_with(out, ExternalCallInBatch {})
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn refund_in_zero_value_batch_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(5), supply: 100)
    let pass = buy(alice, shop, item, qty: 1, value: wei(5))
    let _ = try_seller(shop, SellerMsg::Cancel { item })
    let out = try_checkout(
        alice,
        shop,
        value: Wei::zero(),
        data: dyn_array_from([entry(RefundMsg::Refund { pass })]),
    )
    assert_reverted_with(out, ExternalCallInBatch {})
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn safe_transfer_in_zero_value_batch_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let bob = actor(2)
    let item = ticket(shop, price: wei(5), supply: 100)
    let pass = buy(alice, shop, item, qty: 1, value: wei(5))
    let out = try_checkout(
        alice,
        shop,
        value: Wei::zero(),
        data: dyn_array_from(
            [entry(
                    Erc721Msg::SafeTransferFrom { from: alice, to: bob, tokenId: pass },
                )],
        ),
    )
    assert_reverted_with(out, ExternalCallInBatch {})
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn plain_transfer_in_zero_value_batch_ok() uses (evm: mut Evm) {
    // transferFrom runs no foreign code, so it may be batched.
    let shop = deploy_shop(0)
    let alice = actor(1)
    let bob = actor(2)
    let item = ticket(shop, price: wei(5), supply: 100)
    let first = buy(alice, shop, item, qty: 2, value: wei(10))
    let data = dyn_array_from(
        [
            entry(
                Erc721Msg::TransferFrom { from: alice, to: bob, tokenId: first },
            ),
            entry(
                Erc721Msg::TransferFrom { from: alice, to: bob, tokenId: first + 1 },
            ),
        ],
    )
    let _ = checkout(alice, shop, value: Wei::zero(), data)
    assert!(balance_of(shop, bob) == 2)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn stranger_seller_op_inside_batch_still_owner_checked() uses (evm: mut Evm) {
    // Delegatecall keeps the original caller, so owner checks hold in batches.
    let shop = deploy_shop(0)
    let mallory = actor(3)
    let item = ticket(shop, price: wei(5), supply: 100)
    let out = try_checkout(
        mallory,
        shop,
        value: Wei::zero(),
        data: dyn_array_from([entry(SellerMsg::Cancel { item })]),
    )
    assert_reverted_with(out, NotOwner { caller: mallory })
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn cross_frame_relay_cannot_reuse_batch_budget() uses (evm: mut Evm) {
    // A relay (router, 4337 bundle) pays one batch, then in the same frame
    // tries a zero-value buy: the till must be empty by then.
    let shop = deploy_shop(0)
    let relay = evm.create2<Relay>(value: ether(10), args: (), salt: 77)
    let item = ticket(shop, price: ether(1), supply: 100)
    let first = entry(MulticallMsg::Multicall { data: buys(item, n: 1) })
    let second = entry(SaleMsg::Buy { item, qty: 1 })
    let ok: bool = evm
        .call(
            addr: relay,
            gas: GAS,
            value: Wei::zero(),
            message: RelayMsg::Pair { target: shop, value: ether(1), first, second },
        )
    assert!(!ok)
    let sel: u256 = evm
        .call(
            addr: relay,
            gas: GAS,
            value: Wei::zero(),
            message: RelayMsg::LastSelector {},
        )
    assert!(sel == 0x9539bfce)
    assert!(balance_of(shop, relay) == 1)
    assert_till_clean(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn cross_frame_same_tx_direct_after_batch() uses (evm: mut Evm) {
    // Each fe test is one transaction: frame two sees frame one's transient
    // storage unless the till cleared it.
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: ether(1), supply: 100)
    let _ = checkout(tobi, shop, value: ether(1), data: buys(item, n: 1))
    assert_till_clean(shop)
    assert_reverted_with(
        ingot::testkit::try_buy(tobi, shop, item, qty: 1, value: Wei::zero()),
        Overspend { wanted: ether(1), left: Wei::zero() },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn empty_checkout_zero_value_ok() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let _ = checkout(tobi, shop, value: Wei::zero(), data: DynArray::empty())
    assert_till_clean(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn empty_checkout_with_value_reverts_unspent() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    assert_reverted_with(
        try_checkout(tobi, shop, value: wei(1), data: DynArray::empty()),
        Unspent { left: wei(1) },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn fifty_entry_checkout() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let tobi = actor(4)
    let item = ticket(shop, price: wei(3), supply: 100)
    let _ = checkout(tobi, shop, value: wei(150), data: buys(item, n: 50))
    assert!(balance_of(shop, tobi) == 50)
    assert_books_exact(shop)
}
