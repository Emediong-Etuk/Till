// ERC-721 conformance of passes.
use std::abi::{Bytes, Bytes4, DynString}
use std::evm::{Call, Evm, wei}
use actors::{ActorMsg, ReentrantMsg, ReentrantReceiver, Report}
use ingot::{Erc721Msg, SaleMsg}
use ingot::errors::{
    InvalidOwner,
    InvalidRecipient,
    NotAuthorized,
    UnknownPass,
    UnsafeRecipient,
    WrongFrom,
}
use ingot::testkit::{
    GAS,
    actor,
    assert_reverted_with,
    balance_of,
    buy,
    deploy_shop,
    exec,
    owner_of,
    ticket,
    try_exec,
}
use till::entry

fn setup() -> (Address, Address, Address, u256) uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let bob = actor(2)
    let item = ticket(shop, price: wei(10), supply: 100)
    let pass = buy(alice, shop, item, qty: 2, value: wei(20))
    (shop, alice, bob, pass)
}

fn supports(_ shop: Address, _ id: u256) -> bool uses (evm: mut Evm) {
    evm.call(
        addr: shop,
        gas: GAS,
        value: Wei::zero(),
        message: Erc721Msg::SupportsInterface { interfaceId: Bytes4 { val: id } },
    )
}

fn approved(_ shop: Address, _ id: u256) -> Address uses (evm: mut Evm) {
    evm.call(
        addr: shop,
        gas: GAS,
        value: Wei::zero(),
        message: Erc721Msg::GetApproved { tokenId: id },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn supports_erc165_erc721_metadata() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    assert!(supports(shop, 0x01ffc9a7))
    assert!(supports(shop, 0x80ac58cd))
    assert!(supports(shop, 0x5b5e139f))
    assert!(!supports(shop, 0xffffffff))
    assert!(!supports(shop, 0x780e9d63)) // no Enumerable
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn name_and_symbol_strings() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let name: DynString = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::Name {},
        )
    let symbol: DynString = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::Symbol {},
        )
    assert!(
        name == DynString::from_word_prefix(word: ingot::testkit::NAME, len: 14),
    )
    assert!(
        symbol == DynString::from_word_prefix(word: ingot::testkit::SYMBOL, len: 3),
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn token_uri_is_base_shop_and_id() uses (evm: mut Evm) {
    let (shop, _, _, pass) = setup()
    let uri: DynString = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::TokenUri { tokenId: pass + 1 },
        )
    // 31 bytes of base, "0x" + 40 hex digits, "/", "2".
    assert!(uri.len() == 31 + 42 + 1 + 1)
    assert!(uri.span().word_at(0) >> 8 == ingot::testkit::URI0 >> 8)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn token_uri_of_unknown_pass_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let out = with (Call = evm) {
        evm.try_call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::TokenUri { tokenId: 1 },
        )
    }
    assert_reverted_with(out, UnknownPass { pass: 1 })
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn owner_of_unknown_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let out = with (Call = evm) {
        evm.try_call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::OwnerOf { tokenId: 1 },
        )
    }
    assert_reverted_with(out, UnknownPass { pass: 1 })
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn balance_of_zero_address_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let out = with (Call = evm) {
        evm.try_call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::BalanceOf { owner: Address::zero() },
        )
    }
    assert_reverted_with(out, InvalidOwner {})
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn transfer_by_owner() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::TransferFrom { from: alice, to: bob, tokenId: pass },
        ),
    )
    assert!(owner_of(shop, pass) == bob)
    assert!(balance_of(shop, alice) == 1 && balance_of(shop, bob) == 1)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn transfer_by_approved_clears_approval() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(Erc721Msg::Approve { to: bob, tokenId: pass }),
    )
    assert!(approved(shop, pass) == bob)
    let _ = exec(
        bob,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::TransferFrom { from: alice, to: bob, tokenId: pass },
        ),
    )
    assert!(owner_of(shop, pass) == bob)
    assert!(approved(shop, pass) == Address::zero())
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn transfer_by_operator() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SetApprovalForAll { operator: bob, approved: true },
        ),
    )
    let is_op: bool = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::IsApprovedForAll { owner: alice, operator: bob },
        )
    assert!(is_op)
    let _ = exec(
        bob,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::TransferFrom { from: alice, to: bob, tokenId: pass + 1 },
        ),
    )
    assert!(owner_of(shop, pass + 1) == bob)
    // Revoking stops it.
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SetApprovalForAll { operator: bob, approved: false },
        ),
    )
    assert_reverted_with(
        try_exec(
            bob,
            target: shop,
            value: Wei::zero(),
            data: entry(
                Erc721Msg::TransferFrom { from: alice, to: bob, tokenId: pass },
            ),
        ),
        NotAuthorized { caller: bob, pass },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn operator_may_approve() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    let kemi = actor(5)
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SetApprovalForAll { operator: bob, approved: true },
        ),
    )
    let _ = exec(
        bob,
        target: shop,
        value: Wei::zero(),
        data: entry(Erc721Msg::Approve { to: kemi, tokenId: pass }),
    )
    assert!(approved(shop, pass) == kemi)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn transfer_by_stranger_reverts() uses (evm: mut Evm) {
    let (shop, alice, _, pass) = setup()
    let mallory = actor(3)
    assert_reverted_with(
        try_exec(
            mallory,
            target: shop,
            value: Wei::zero(),
            data: entry(
                Erc721Msg::TransferFrom { from: alice, to: mallory, tokenId: pass },
            ),
        ),
        NotAuthorized { caller: mallory, pass },
    )
}

