fn approve_by_stranger_reverts() uses (evm: mut Evm) {
    let (shop, _, _, pass) = setup()
    let mallory = actor(3)
    assert_reverted_with(
        try_exec(
            mallory,
            target: shop,
            value: Wei::zero(),
            data: entry(Erc721Msg::Approve { to: mallory, tokenId: pass }),
