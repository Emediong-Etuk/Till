#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn safe_transfer_to_accepting_contract() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SafeTransferFrom { from: alice, to: bob, tokenId: pass },
        ),
    )
    assert!(owner_of(shop, pass) == bob)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn safe_transfer_with_data() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SafeTransferFromData {
                from: alice,
                to: bob,
                tokenId: pass,
                data: Bytes::from_word_prefix(word: 0xbeef << 240, len: 2),
            },
        ),
    )
    assert!(owner_of(shop, pass) == bob)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn safe_transfer_to_eoa() uses (evm: mut Evm) {
    let (shop, alice, _, pass) = setup()
    let eoa = Address::new(0xa11ce)
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SafeTransferFrom { from: alice, to: eoa, tokenId: pass },
        ),
    )
    assert!(owner_of(shop, pass) == eoa)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn safe_transfer_to_refusing_contract_reverts() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    evm.call(
        addr: bob,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::SetAcceptTokens { accept: false },
    )
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: Wei::zero(),
            data: entry(
                Erc721Msg::SafeTransferFrom { from: alice, to: bob, tokenId: pass },
            ),
        ),
        UnsafeRecipient { to: bob },
    )
    assert!(owner_of(shop, pass) == alice)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn safe_transfer_to_non_receiver_contract_reverts() uses (evm: mut Evm) {
    // The shop itself has no onERC721Received.
    let (shop, alice, _, pass) = setup()
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: Wei::zero(),
            data: entry(
                Erc721Msg::SafeTransferFrom { from: alice, to: shop, tokenId: pass },
            ),
        ),
        UnsafeRecipient { to: shop },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn reentrant_receiver_on_safe_transfer_cannot_spend_others_money()
uses (evm: mut Evm)
{
    // The receiver gets control during safeTransferFrom (outside any batch)
    // and tries to buy without paying.
    let (shop, alice, _, pass) = setup()
    let thief = evm.create2<ReentrantReceiver>(value: Wei::zero(), args: (), salt: 66)
    evm.call(
        addr: thief,
        gas: GAS,
        value: Wei::zero(),
        message: ReentrantMsg::Arm {
            target: shop,
            value: Wei::zero(),
            data: entry(SaleMsg::Buy { item: 0, qty: 1 }),
        },
    )
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::SafeTransferFrom { from: alice, to: thief, tokenId: pass },
        ),
    )
    let r: Report = evm
        .call(
            addr: thief,
            gas: GAS,
            value: Wei::zero(),
            message: ReentrantMsg::GetReport {},
        )
    assert!(r.attempts == 1 && r.successes == 0)
    assert!(r.last_selector == 0x9539bfce) // Overspend
    assert!(owner_of(shop, pass) == thief)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn get_approved_of_unknown_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let out = with (Call = evm) {
        evm.try_call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: Erc721Msg::GetApproved { tokenId: 3 },
        )
    }
    assert_reverted_with(out, UnknownPass { pass: 3 })
}
