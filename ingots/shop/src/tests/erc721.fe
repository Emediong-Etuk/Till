}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn transfer_wrong_from_reverts() uses (evm: mut Evm) {
    let (shop, alice, bob, pass) = setup()
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: Wei::zero(),
            data: entry(
                Erc721Msg::TransferFrom { from: bob, to: alice, tokenId: pass },
            ),
        ),
        WrongFrom { pass, owner: alice },
    )
}

