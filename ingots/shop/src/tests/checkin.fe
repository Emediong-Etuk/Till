#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_garbage_signature_reverts() uses (evm: mut Evm) {
    let (shop, _) = setup()
    assert_reverted_with(
        redeem(shop, pass: 1, deadline: DL, sig: Bytes::empty()),
        BadSignature { holder: signer0() },
    )
    assert_reverted_with(
        redeem(
            shop,
            pass: 1,
            deadline: DL,
            sig: bytes_of([0, 0, 0], len: 65),
        ),
        BadSignature { holder: signer0() },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_by_stranger_reverts() uses (evm: mut Evm) {
    let (shop, _) = setup()
    let mallory = actor(3)
    let out = try_exec(
        mallory,
        target: shop,
        value: Wei::zero(),
        data: entry(
            SellerMsg::Redeem { pass: 1, deadline: DL, sig: bytes_of(P1_SIG, len: P1_SIG_LEN) },
        ),
    )
    assert_reverted_with(out, NotOwner { caller: mallory })
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_unknown_pass_reverts() uses (evm: mut Evm) {
    let (shop, _) = setup()
    assert_reverted_with(
        redeem(
            shop,
            pass: 99,
            deadline: DL,
            sig: bytes_of(P1_SIG, len: P1_SIG_LEN),
        ),
        UnknownPass { pass: 99 },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_cancelled_item_reverts() uses (evm: mut Evm) {
    let (shop, item) = setup()
    let _ = try_seller(shop, SellerMsg::Cancel { item })
    assert_reverted_with(
        redeem(
            shop,
            pass: 1,
            deadline: DL,
            sig: bytes_of(P1_SIG, len: P1_SIG_LEN),
        ),
        ItemNotActive { item, status: ingot::CANCELLED },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn door_batch_redeems_a_queue() uses (evm: mut Evm) {
    let (shop, item) = setup()
    let data = dyn_array_from(
        [
            entry(
                SellerMsg::Redeem { pass: 1, deadline: DL, sig: bytes_of(P1_SIG, len: P1_SIG_LEN) },
            ),
            entry(
                SellerMsg::Redeem { pass: 2, deadline: DL, sig: bytes_of(P2_SIG, len: P2_SIG_LEN) },
            ),
        ],
    )
    let _: DynArray<Bytes> = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: MulticallMsg::Multicall { data },
        )
    assert!(pass_of(shop, 1).redeemed && pass_of(shop, 2).redeemed)
    assert!(item_of(shop, item).escrow == Wei::zero())
    assert!(books(shop).seller_available == wei(200))
}

// --- ERC-1271 holders ---------------------------------------------------------

/// A contract holder (Actor) with one pass of a fresh shop.
fn contract_holder_setup() -> (Address, Address, u256, u256)
uses (evm: mut Evm)
{
    let shop = deploy_shop(0)
    let item = ticket(shop, price: wei(100), supply: 10)
    let holder = actor(7)
    let pass = ingot::testkit::buy(holder, shop, item, qty: 1, value: wei(100))
    (shop, holder, item, pass)
}

fn approve_digest(_ holder: Address, _ shop: Address, pass: u256)
uses (evm: mut Evm)
{
    let d: Bytes32 = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::CheckInDigest { pass, deadline: DL },
        )
    evm.call(
        addr: holder,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Approve { digest: d },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_erc1271_holder() uses (evm: mut Evm) {
    let (shop, holder, _, pass) = contract_holder_setup()
    approve_digest(holder, shop, pass)
    assert!(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()).success(),
    )
    assert!(pass_of(shop, pass).redeemed)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_erc1271_without_approval_reverts() uses (evm: mut Evm) {
    let (shop, holder, _, pass) = contract_holder_setup()
    assert_reverted_with(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()),
        BadSignature { holder },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn previous_holder_signature_dies_on_transfer() uses (evm: mut Evm) {
    let (shop, holder, _, pass) = contract_holder_setup()
    approve_digest(holder, shop, pass)
    let bob = actor(2)
    let _ = exec(
        holder,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::TransferFrom { from: holder, to: bob, tokenId: pass },
        ),
    )
    assert_reverted_with(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()),
        BadSignature { holder: bob },
    )
    approve_digest(bob, shop, pass)
    assert!(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()).success(),
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeemed_pass_stays_redeemed_after_transfer() uses (evm: mut Evm) {
    let (shop, holder, _, pass) = contract_holder_setup()
    approve_digest(holder, shop, pass)
    assert!(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()).success(),
    )
    let bob = actor(2)
    let _ = exec(
        holder,
        target: shop,
        value: Wei::zero(),
        data: entry(
            Erc721Msg::TransferFrom { from: holder, to: bob, tokenId: pass },
        ),
    )
    assert!(
        pass_of(shop, pass).redeemed && pass_of(shop, pass).owner == bob,
    )
    approve_digest(bob, shop, pass)
    assert_reverted_with(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()),
        AlreadyRedeemed { pass },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn refund_after_redeem_reverts() uses (evm: mut Evm) {
    let (shop, holder, item, pass) = contract_holder_setup()
    approve_digest(holder, shop, pass)
    assert!(
        redeem(shop, pass, deadline: DL, sig: Bytes::empty()).success(),
    )
    let _ = try_seller(shop, SellerMsg::Cancel { item })
    assert_reverted_with(
        try_exec(
            holder,
            target: shop,
            value: Wei::zero(),
            data: entry(RefundMsg::Refund { pass }),
        ),
        NotRefundable { pass },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_after_release_moves_no_money() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let item = add_item(
        shop,
        price: wei(100),
        supply: 10,
        cap: 0,
        release_at: Timestamp::from_seconds(0),
    )
    let holder = actor(7)
    let pass = ingot::testkit::buy(holder, shop, item, qty: 1, value: wei(100))
    let _ = try_seller(shop, SellerMsg::Release { item })
    approve_digest(holder, shop, pass)
    let released: Wei = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: SellerMsg::Redeem { pass, deadline: DL, sig: Bytes::empty() },
        )
    assert!(released == Wei::zero())
    assert!(books(shop).seller_available == wei(100))
    assert_books_exact(shop)
}
