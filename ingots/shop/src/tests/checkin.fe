#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn redeem_signature_for_other_deadline_reverts() uses (evm: mut Evm) {
    let (shop, _) = setup()
    assert_reverted_with(
        redeem(
            shop,
            pass: 1,
            deadline: DL,
            sig: bytes_of(P1_LATER, len: P1_LATER_LEN),
        ),
        BadSignature { holder: signer0() },
    )
    assert!(
        redeem(
            shop,
            pass: 1,
            deadline: Timestamp::from_seconds(DEADLINE_LATER),
            sig: bytes_of(P1_LATER, len: P1_LATER_LEN),
        )
            .success(),
