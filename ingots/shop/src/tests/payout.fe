}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn withdraw_to_zero_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    assert_reverted_with(
        try_seller(shop, SellerMsg::Withdraw { to: Address::zero() }),
        InvalidRecipient {},
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn withdraw_to_rejecting_receiver_keeps_funds() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let rej = evm.create2<RejectingReceiver>(value: Wei::zero(), args: (), salt: 55)
    let _ = exec(
        alice,
        target: shop,
        value: wei(5),
        data: entry(SaleMsg::Tip { amount: wei(5) }),
    )
    assert_reverted_with(
        try_seller(shop, SellerMsg::Withdraw { to: rej }),
        PayoutFailed { to: rej, amount: wei(5) },
    )
    assert!(books(shop).seller_available == wei(5))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn withdraw_to_reentrant_receiver_cannot_reenter() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let thief = evm.create2<ReentrantReceiver>(value: Wei::zero(), args: (), salt: 66)
    let _ = exec(
        alice,
        target: shop,
        value: wei(5),
        data: entry(SaleMsg::Tip { amount: wei(5) }),
    )
    let _ = exec(
        alice,
        target: shop,
        value: wei(6),
        data: entry(SaleMsg::Tip { amount: wei(6) }),
    )
    evm.call(
        addr: thief,
        gas: GAS,
        value: Wei::zero(),
        message: ReentrantMsg::Arm {
            target: shop,
            value: Wei::zero(),
            data: entry(SellerMsg::Withdraw { to: thief }),
        },
    )
    assert!(withdraw(shop, to: thief) == wei(11))
    let r: Report = evm
        .call(
            addr: thief,
            gas: GAS,
            value: Wei::zero(),
            message: ReentrantMsg::GetReport {},
        )
    assert!(r.attempts == 1 && r.successes == 0)
    assert!(evm.balance(thief) == wei(11))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn forced_eth_is_sweepable_and_never_breaks_books() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let sink = actor(9)
    let item = ticket(shop, price: wei(10), supply: 10)
    let _ = buy(alice, shop, item, qty: 1, value: wei(10))
    let force = evm.create2<ForceSend>(value: Wei::zero(), args: (), salt: 88)
    let ok: bool = evm
        .call(
            addr: force,
            gas: GAS,
            value: wei(777),
            message: ForceMsg::Force { to: shop },
        )
    assert!(ok)
    assert!(evm.balance(shop) == wei(787))
    assert_books_covered(shop)
    let swept: Wei = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: SellerMsg::Sweep { to: sink },
        )
    assert!(swept == wei(777))
    assert_books_exact(shop)
    assert_reverted_with(
        try_seller(shop, SellerMsg::Sweep { to: sink }),
        NothingToWithdraw {},
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn eth_sent_before_deployment_is_sweepable() uses (evm: mut Evm) {
    // A counterfactual shop address can receive ETH before it has code.
    let predicted = std::evm::predict_create2<ingot::Shop>(
        deployer: evm.address(),
        args: (
            evm.address(),
            ingot::testkit::NAME,
            ingot::testkit::SYMBOL,
            ingot::testkit::URI0,
            0,
            ingot::testkit::URI_LEN,
        ),
        salt: 5,
    )
    let alice = actor(1)
    let _ = exec(
        alice,
        target: predicted,
        value: wei(42),
        data: Bytes::empty(),
    )
    let shop = deploy_shop(5)
    assert!(shop == predicted)
    assert!(evm.balance(shop) == wei(42))
    assert_books_covered(shop)
    let sink = actor(9)
    let swept: Wei = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: SellerMsg::Sweep { to: sink },
        )
    assert!(swept == wei(42))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn sweep_by_stranger_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
