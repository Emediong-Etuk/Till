}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn accounting_view_reports_balance() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: ether(1), supply: 10)
    let _ = buy(alice, shop, item, qty: 2, value: ether(2))
    let b: ingot::AccountingView = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::Accounting {},
        )
    assert!(b.balance == ether(2) && b.total_escrow == ether(2))
}
