// Direct (unbatched) purchases, tips and notes (I1, I2, I7, I11).
use std::evm::{Evm, ether, wei}
use ingot::{SaleMsg, ViewMsg}
use ingot::errors::{
    InvalidRecipient,
    ItemNotActive,
    SoldOut,
    UnknownItem,
    WalletCapExceeded,
    ZeroAmount,
    ZeroQuantity,
}
use ingot::testkit::{
    GAS,
    actor,
    add_item,
    assert_books_exact,
    assert_reverted_with,
    assert_selector,
    assert_till_clean,
    balance_of,
    books,
    buy,
    deploy_shop,
    exec,
    item_of,
    owner_of,
    pass_of,
    ticket,
    try_buy,
    try_exec,
}
use till::{Overspend, Unspent, entry}

const T1000: Timestamp = Timestamp::from_seconds(1000)
const WEI_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_exact_mints_and_escrows() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: ether(1), supply: 10)
    let first = buy(alice, shop, item, qty: 2, value: ether(2))
    assert!(first == 1)
    assert!(owner_of(shop, 1) == alice && owner_of(shop, 2) == alice)
    assert!(balance_of(shop, alice) == 2)
    let it = item_of(shop, item)
    assert!(it.sold == 2 && it.escrow == ether(2))
    let b = books(shop)
    assert!(
        b.total_escrow == ether(2) && b.seller_available == Wei::zero(),
    )
    assert_books_exact(shop)
    assert_till_clean(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_records_price_per_pass() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(777), supply: 10)
    let first = buy(alice, shop, item, qty: 3, value: wei(2331))
    var id = first
    while id < first + 3 {
        let p = pass_of(shop, id)
        assert!(
            p.item == item && p.paid == wei(777) && !p.redeemed && p.owner == alice,
        )
        id += 1
    }
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn pass_ids_are_sequential_across_buyers() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let bob = actor(2)
    let item = ticket(shop, price: wei(1), supply: 10)
    assert!(buy(alice, shop, item, qty: 2, value: wei(2)) == 1)
    assert!(buy(bob, shop, item, qty: 3, value: wei(3)) == 3)
    assert!(buy(alice, shop, item, qty: 1, value: wei(1)) == 6)
    let minted: u256 = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::TotalMinted {},
        )
    assert!(minted == 6)
    assert!(owner_of(shop, 5) == bob)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_overpay_reverts_unspent() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: ether(1), supply: 10)
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 1, value: ether(1) + wei(1)),
        Unspent { left: wei(1) },
    )
    assert!(evm.balance(shop) == Wei::zero())
    assert!(item_of(shop, item).sold == 0)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_underpay_reverts_overspend() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: ether(1), supply: 10)
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 2, value: ether(1)),
        Overspend { wanted: ether(2), left: ether(1) },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_zero_qty_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: ether(1), supply: 10)
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 0, value: Wei::zero()),
        ZeroQuantity {},
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_beyond_supply_reverts_sold_out() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(1), supply: 3)
    let _ = buy(alice, shop, item, qty: 2, value: wei(2))
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 2, value: wei(2)),
        SoldOut { item, remaining: 1 },
    )
    let _ = buy(alice, shop, item, qty: 1, value: wei(1))
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 1, value: wei(1)),
        SoldOut { item, remaining: 0 },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_huge_qty_reverts_sold_out_not_overflow() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(2), supply: 3)
    assert_reverted_with(
        try_buy(alice, shop, item, qty: WEI_MAX, value: wei(2)),
        SoldOut { item, remaining: 3 },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_price_times_qty_overflow_panics() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(WEI_MAX / 2 + 1), supply: 10)
    let out = try_buy(alice, shop, item, qty: 2, value: wei(1))
    assert_selector<std::evm::Panic>(out)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_wei_max_price_needs_wei_max_value() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(WEI_MAX), supply: 10)
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 1, value: ether(100)),
        Overspend { wanted: wei(WEI_MAX), left: ether(100) },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn wallet_cap_enforced_per_wallet() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let bob = actor(2)
    let item = add_item(
        shop,
        price: wei(1),
        supply: 100,
        cap: 2,
        release_at: T1000,
    )
    let _ = buy(alice, shop, item, qty: 2, value: wei(2))
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 1, value: wei(1)),
        WalletCapExceeded { item, cap: 2, held: 2 },
    )
    // Bob has his own cap.
    let _ = buy(bob, shop, item, qty: 2, value: wei(2))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn wallet_cap_single_large_order() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = add_item(
        shop,
        price: wei(1),
        supply: 100,
        cap: 2,
        release_at: T1000,
    )
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 3, value: wei(3)),
        WalletCapExceeded { item, cap: 2, held: 0 },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn gift_applies_cap_to_recipient() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let bob = actor(2)
    let item = add_item(
        shop,
        price: wei(1),
        supply: 100,
        cap: 2,
        release_at: T1000,
    )
    let out = exec(
        alice,
        target: shop,
        value: wei(2),
        data: entry(SaleMsg::BuyFor { item, qty: 2, to: bob }),
    )
    assert!(owner_of(shop, out.word_at(0)) == bob)
    assert!(balance_of(shop, bob) == 2)
    // Bob is now at his cap, whoever pays; Alice still has hers.
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: wei(1),
            data: entry(SaleMsg::BuyFor { item, qty: 1, to: bob }),
        ),
        WalletCapExceeded { item, cap: 2, held: 2 },
    )
    let _ = buy(alice, shop, item, qty: 2, value: wei(2))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn gift_to_zero_address_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(1), supply: 10)
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: wei(1),
            data: entry(SaleMsg::BuyFor { item, qty: 1, to: Address::zero() }),
        ),
        InvalidRecipient {},
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_unknown_item_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    assert_reverted_with(
        try_buy(alice, shop, item: 4, qty: 1, value: wei(1)),
        UnknownItem { item: 4 },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn free_item_with_zero_value() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: Wei::zero(), supply: 10)
    let first = buy(alice, shop, item, qty: 3, value: Wei::zero())
    assert!(first == 1)
    assert!(books(shop).total_escrow == Wei::zero())
    // Free items still reject stray value.
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 1, value: wei(1)),
        Unspent { left: wei(1) },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn tip_direct_goes_to_seller() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let _ = exec(
        alice,
        target: shop,
        value: wei(500),
        data: entry(SaleMsg::Tip { amount: wei(500) }),
    )
    let b = books(shop)
    assert!(
        b.seller_available == wei(500) && b.tips_total == wei(500) && b.total_escrow == Wei::zero(),
    )
    assert_books_exact(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn tip_zero_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: Wei::zero(),
            data: entry(SaleMsg::Tip { amount: Wei::zero() }),
        ),
        ZeroAmount {},
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn tip_overpay_reverts_unspent() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: wei(6),
            data: entry(SaleMsg::Tip { amount: wei(5) }),
        ),
        Unspent { left: wei(1) },
    )
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn note_direct_zero_value_ok() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let _ = exec(
        alice,
        target: shop,
        value: Wei::zero(),
        data: entry(
            SaleMsg::Note { text: std::abi::Bytes32 { val: 0x6869 << 240 } },
        ),
    )
    assert_till_clean(shop)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn stray_value_to_note_reverts_unspent() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    assert_reverted_with(
        try_exec(
            alice,
            target: shop,
            value: wei(3),
            data: entry(SaleMsg::Note { text: std::abi::Bytes32 { val: 1 } }),
        ),
        Unspent { left: wei(3) },
    )
    assert!(evm.balance(shop) == Wei::zero())
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn stray_value_to_view_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let out = try_exec(
        alice,
        target: shop,
        value: wei(3),
        data: entry(ViewMsg::ItemCount {}),
    )
    assert!(!out.success())
    assert!(evm.balance(shop) == Wei::zero())
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn plain_eth_transfer_to_shop_reverts() uses (evm: mut Evm) {
    // No fallback: ETH sent without a handler is refused, never stuck.
    let shop = deploy_shop(0)
    let alice = actor(1)
    let out = try_exec(
        alice,
        target: shop,
        value: wei(3),
        data: std::abi::Bytes::empty(),
    )
    assert!(!out.success())
    assert!(evm.balance(shop) == Wei::zero())
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_after_release_time_still_escrowed() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = add_item(
        shop,
        price: wei(9),
        supply: 5,
        cap: 0,
        release_at: Timestamp::from_seconds(0),
    )
    let _ = buy(alice, shop, item, qty: 1, value: wei(9))
    assert!(item_of(shop, item).escrow == wei(9))
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn buy_paused_item_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let alice = actor(1)
    let item = ticket(shop, price: wei(9), supply: 5)
    let _ = ingot::testkit::try_seller(shop, ingot::SellerMsg::Pause { item })
    assert_reverted_with(
        try_buy(alice, shop, item, qty: 1, value: wei(9)),
        ItemNotActive { item, status: ingot::PAUSED },
    )
}
