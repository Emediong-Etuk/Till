// Seller item management (I9, I12).
use std::abi::{Bytes, DynArray, dyn_array_from}
use std::evm::{Evm, ether, wei}
use std::evm::multicall::MulticallMsg
use ingot::{ACTIVE, CANCELLED, PAUSED, SellerMsg, ViewMsg}
use ingot::errors::{
    CannotShortenRelease,
    InvalidItem,
    ItemNotActive,
    NotOwner,
    SoldOut,
    SupplyBelowSold,
    UnknownItem,
}
use ingot::testkit::{
    GAS,
    actor,
    add_item,
    assert_reverted_with,
    buy,
    deploy_shop,
    item_of,
    label,
    pass_of,
    ticket,
    try_buy,
    try_exec,
    try_seller,
}
use till::entry

const T1000: Timestamp = Timestamp::from_seconds(1000)

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn add_item_direct() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let id = add_item(
        shop,
        price: ether(1),
        supply: 50,
        cap: 4,
        release_at: T1000,
    )
    assert!(id == 0)
    let it = item_of(shop, 0)
    assert!(
        it.price == ether(1) && it.supply == 50 && it.sold == 0 && it.max_per_wallet == 4,
    )
    assert!(
        it.release_at == T1000 && it.status == ACTIVE && it.escrow == Wei::zero(),
    )
    let n: u256 = evm.call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::ItemCount {},
        )
    assert!(n == 1)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn add_three_items_in_one_zero_value_batch() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let data = dyn_array_from(
        [
            entry(
                SellerMsg::AddItem {
                    price: wei(1000),
                    supply: 100,
                    maxPerWallet: 4,
                    releaseAt: T1000,
                    kind: 0,
                    label: label(0x47454e << 232),
                },
            ),
            entry(
                SellerMsg::AddItem {
                    price: wei(3000),
                    supply: 20,
                    maxPerWallet: 2,
                    releaseAt: T1000,
                    kind: 0,
                    label: label(0x564950 << 232),
                },
            ),
            entry(
                SellerMsg::AddItem {
                    price: wei(1500),
                    supply: 40,
                    maxPerWallet: 0,
                    releaseAt: T1000,
                    kind: 1,
                    label: label(0x5348495254 << 216),
                },
            ),
        ],
    )
    let out: DynArray<Bytes> = evm
        .call(
            addr: shop,
            gas: GAS,
            value: Wei::zero(),
            message: MulticallMsg::Multicall { data },
        )
    assert!(out.len() == 3)
    assert!(out.get(2).word_at(0) == 2)
    assert!(item_of(shop, 1).price == wei(3000))
    assert!(item_of(shop, 2).kind == 1)
    assert!(item_of(shop, 2).label.val == 0x5348495254 << 216)
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn add_item_by_stranger_reverts_not_owner() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let mallory = actor(3)
    let out = try_exec(
        mallory,
        target: shop,
        value: Wei::zero(),
        data: entry(
            SellerMsg::AddItem {
                price: wei(1),
                supply: 1,
                maxPerWallet: 0,
                releaseAt: T1000,
                kind: 0,
                label: label(0),
            },
        ),
    )
    assert_reverted_with(out, NotOwner { caller: mallory })
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn add_item_zero_supply_reverts() uses (evm: mut Evm) {
    let shop = deploy_shop(0)
    let out = try_seller(
        shop,
        SellerMsg::AddItem {
            price: wei(1),
            supply: 0,
            maxPerWallet: 0,
            releaseAt: T1000,
            kind: 0,
            label: label(0),
        },
    )
    assert_reverted_with(out, InvalidItem {})
}

#[test(balance = 1_000_000_000_000_000_000_000_000)]
fn add_item_bad_kind_reverts() uses (evm: mut Evm) {
